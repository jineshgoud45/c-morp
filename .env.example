# C-MORP Environment Configuration
# Copy this file to .env and update the values

# Database Configuration
POSTGRES_USER=cmorp_user
POSTGRES_PASSWORD=secure_password_here
POSTGRES_DB=microgrid_db
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# TimescaleDB Configuration
TIMESCALEDB_PASSWORD=${POSTGRES_PASSWORD}
TIMESCALEDB_URL=postgresql://postgres:${TIMESCALEDB_PASSWORD}@timescaledb:5432/postgres

# Redis Configuration
REDIS_PASSWORD=redis_password_here
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379

# MQTT Broker Configuration
MQTT_BROKER=mosquitto
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# API Configuration
API_HOST=0.0.0.0
API_PORT=5000
API_DEBUG=false
API_RELOAD=false

# Security
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

# CORS Configuration
CORS_ORIGINS=["http://localhost:8080", "https://yourdomain.com"]
CORS_ALLOW_CREDENTIALS=true

# External Services
WEATHER_API_KEY=your-weather-api-key
ALERT_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
WHATSAPP_API_KEY=your-whatsapp-api-key

# Optimization Settings
DEFAULT_SOLVER_TIMEOUT=300
MAX_OPTIMIZATION_HORIZON=168
MIN_SOLVER_INTERVAL=60

# Energy System Configuration
BATTERY_CAPACITY_KWH=500
MAX_BATTERY_POWER_KW=250
SOLAR_CAPACITY_KW=300
GRID_CONNECTION_KVA=1000

# Tariff Configuration (INR/kWh)
PEAK_TARIFF=8.5
OFF_PEAK_TARIFF=4.5
MID_PEAK_TARIFF=6.5

# Time Configuration
TIMEZONE=Asia/Kolkata
CURRENCY=INR
UNITS=metric

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=/app/logs/cmorp.log

# Monitoring
PROMETHEUS_PORT=9090
METRICS_ENABLED=true
HEALTH_CHECK_INTERVAL=30

# Performance
MAX_WORKERS=4
WORKER_TIMEOUT=30
KEEP_ALIVE_TIMEOUT=65

# Development Settings
DEVELOPMENT_MODE=false
ENABLE_PROFILING=false
ENABLE_DEBUG_ROUTES=false

# PWA Configuration
PWA_NAME=C-MORP
PWA_SHORT_NAME=C-MORP
PWA_DESCRIPTION=Campus Microgrid Optimization Platform
PWA_THEME_COLOR=#2E7D32
PWA_BACKGROUND_COLOR=#FAFAFA

# Grafana Configuration
GRAFANA_ADMIN_PASSWORD=admin123
GRAFANA_PORT=3000

# SSL Configuration (for production)
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 2 * * *"
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=cmorp-backups